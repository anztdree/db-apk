+package com.db.local.server;
+
+import java.io.BufferedInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.Socket;
+import java.net.SocketTimeoutException;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Satu koneksi HTTP: parse request line + header + body (Content-Length, cap 8 MB),
+ * dispatch ke handler per port, tulis respons. Keep-alive HTTP/1.1 sederhana
+ * (loop baca berikutnya bila client minta keep-alive).
+ */
+public final class HttpWorker implements Runnable {
+    public static final int MAX_BODY = 8 * 1024 * 1024;
+    public static final int MAX_HEADER = 64 * 1024;
+
+    public static final class Request {
+        public String method, rawPath, path, query;
+        public Map<String, String> headers = new HashMap<>();
+        public byte[] body = new byte[0];
+
+        public String header(String name) {
+            return headers.get(name.toLowerCase());
+        }
+        public String q(String name) {
+            if (query == null) return null;
+            String[] parts = query.split("&");
+            for (String p : parts) {
+                int eq = p.indexOf('=');
+                if (eq > 0 && p.substring(0, eq).equals(name)) return p.substring(eq + 1);
+            }
+            return null;
+        }
+    }
+
+    public interface Handler {
+        /** tulis respons ke out; kembalikan true bila respons terkirim dan keep-alive boleh lanjut */
+        boolean handle(Request req, OutputStream out, Socket sock) throws IOException;
+    }
+
+    private final Socket sock;
+    private final Handler handler;
+    private final int listenerPort;
+
+    public HttpWorker(Socket sock, Handler handler, int listenerPort) {
+        this.sock = sock;
+        this.handler = handler;
+        this.listenerPort = listenerPort;
+    }
+
+    @Override
+    public void run() {
+        try {
+            sock.setSoTimeout(8000);
+            InputStream in = new BufferedInputStream(sock.getInputStream());
+            OutputStream out = sock.getOutputStream();
+            while (true) {
+                Request req;
+                try {
+                    req = readRequest(in);
+                } catch (SocketTimeoutException ste) {
+                    break; // idle timeout keep-alive
+                }
+                if (req == null) break;
+                req.headers.put("__listenerport", String.valueOf(listenerPort));
+                boolean keep = !"close".equalsIgnoreCase(req.header("connection"))
+                        && !"HTTP/1.0".equalsIgnoreCase(req.header("__proto"));
+                boolean ok;
+                try {
+                    ok = handler.handle(req, out, sock);
+                } catch (IOException ioe) {
+                    break;
+                } catch (Throwable t) {
+                    LoggerCore.Entry e = new LoggerCore.Entry();
+                    e.port = sock.getLocalPort();
+                    e.method = req.method; e.path = req.rawPath;
+                    e.status = 500; e.error = "handler: " + t;
+                    LoggerCore.log(e);
+                    ok = false;
+                }
+                if (!ok || !keep) break;
+            }
+        } catch (Throwable ignored) {
+        } finally {
+            try { sock.close(); } catch (IOException ignored) {}
+        }
+    }
+
+    /** null = koneksi ditutup / EOF; lempar SocketTimeoutException bila idle */
+    private Request readRequest(InputStream in) throws IOException {
+        // baca sampai CRLFCRLF
+        StringBuilder head = new StringBuilder(512);
+        int c;
+        int total = 0;
+        boolean sawAny = false;
+        while ((c = in.read()) != -1) {
+            sawAny = true;
+            head.append((char) c);
+            if (++total > MAX_HEADER) return null;
+            int len = head.length();
+            if (len >= 4 && head.charAt(len - 1) == '\n' && head.charAt(len - 2) == '\r'
+                    && head.charAt(len - 3) == '\n' && head.charAt(len - 4) == '\r') {
+                break;
+            }
+        }
+        if (!sawAny) return null;
+        if (head.length() < 4) return null;
+
+        String headStr = head.toString();
+        String[] lines = headStr.split("\r\n");
+        String[] rl = lines[0].split(" ");
+        if (rl.length < 2) return null;
+        Request req = new Request();
+        req.method = rl[0];
+        req.rawPath = rl[1];
+        int qi = rl[1].indexOf('?');
+        req.path = qi >= 0 ? rl[1].substring(0, qi) : rl[1];
+        req.query = qi >= 0 ? rl[1].substring(qi + 1) : null;
+        for (int i = 1; i < lines.length; i++) {
+            int ci = lines[i].indexOf(':');
+            if (ci > 0) {
+                req.headers.put(lines[i].substring(0, ci).trim().toLowerCase(),
+                        lines[i].substring(ci + 1).trim());
+            }
+        }
+        long cl = 0;
+        String clen = req.header("content-length");
+        if (clen != null) {
+            try { cl = Long.parseLong(clen.trim()); } catch (NumberFormatException nfe) { cl = 0; }
+        }
+        if (cl > MAX_BODY) cl = MAX_BODY; // batasi; sisanya diabaikan (dilaporkan di log)
+        if (cl > 0) {
+            byte[] body = new byte[(int) cl];
+            int off = 0;
+            while (off < body.length) {
+                int r = in.read(body, off, body.length - off);
+                if (r < 0) break;
+                off += r;
+            }
+            req.body = body;
+            req.headers.put("__reqLen", String.valueOf(cl));
+        }
+        return req;
+    }
+
+    /* ---------- penulis respons ---------- */
+
+    public static void writeResponse(OutputStream out, int status, String statusText,
+                                     Map<String, String> headers, byte[] body) throws IOException {
+        StringBuilder h = new StringBuilder(256);
+        h.append("HTTP/1.1 ").append(status).append(' ').append(statusText).append("\r\n");
+        if (headers != null) {
+            for (Map.Entry<String, String> e : headers.entrySet()) {
+                h.append(e.getKey()).append(": ").append(e.getValue()).append("\r\n");
+            }
+        }
+        h.append("Content-Length: ").append(body == null ? 0 : body.length).append("\r\n");
+        h.append("\r\n");
+        out.write(h.toString().getBytes(StandardCharsets.ISO_8859_1));
+        if (body != null && body.length > 0) out.write(body);
+        out.flush();
+    }
+
+    public static Map<String, String> baseHeaders(String contentType) {
+        Map<String, String> m = new HashMap<>();
+        if (contentType != null) m.put("Content-Type", contentType);
+        m.put("Connection", "keep-alive");
+        m.put("Server", "db-local-mini");
+        return m;
+    }
+
+    public static byte[] text(String s) {
+        return s.getBytes(StandardCharsets.UTF_8);
+    }
+}
diff --git a/rebuild-src/javasrc/com/db/local/server/JsonUtil.java b/rebuild-src/javasrc/com/db/local/server/JsonUtil.java
new file mode 100644
index 0000000..dde536f
--- /dev/null
+++ b/rebuild-src/javasrc/com/db/local/server/JsonUtil.java
@@ -0,0 +1,54 @@
+package com.db.local.server;
+
+/**
+ * Utilitas JSON kecil tanpa dependensi (org.json tidak dipakai agar class bisa
+ * diuji di desktop JVM sebelum di-dex). Hanya untuk membangun respons JSON logger.
+ */
+public final class JsonUtil {
+    private JsonUtil() {}
+
+    public static String esc(String s) {
+        if (s == null) return "";
+        StringBuilder b = new StringBuilder(s.length() + 16);
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            switch (c) {
+                case '"':  b.append("\\\""); break;
+                case '\\': b.append("\\\\"); break;
+                case '\n': b.append("\\n");  break;
+                case '\r': b.append("\\r");  break;
+                case '\t': b.append("\\t");  break;
+                default:
+                    if (c < 0x20) b.append(String.format("\\u%04x", (int) c));
+                    else b.append(c);
+            }
+        }
+        return b.toString();
+    }
+
+    /** nama file → Content-Type HTTP (peta minimum untuk isi game egret) */
+    public static String contentType(String path) {
+        String p = path.toLowerCase();
+        if (p.endsWith(".html") || p.endsWith(".htm")) return "text/html; charset=utf-8";
+        if (p.endsWith(".js"))   return "application/javascript; charset=utf-8";
+        if (p.endsWith(".json")) return "application/json; charset=utf-8";
+        if (p.endsWith(".css"))  return "text/css; charset=utf-8";
+        if (p.endsWith(".png"))  return "image/png";
+        if (p.endsWith(".jpg") || p.endsWith(".jpeg")) return "image/jpeg";
+        if (p.endsWith(".gif"))  return "image/gif";
+        if (p.endsWith(".webp")) return "image/webp";
+        if (p.endsWith(".bmp"))  return "image/bmp";
+        if (p.endsWith(".svg"))  return "image/svg+xml";
+        if (p.endsWith(".mp3"))  return "audio/mpeg";
+        if (p.endsWith(".wav"))  return "audio/wav";
+        if (p.endsWith(".ogg"))  return "audio/ogg";
+        if (p.endsWith(".mp4"))  return "video/mp4";
+        if (p.endsWith(".ttf"))  return "font/ttf";
+        if (p.endsWith(".fnt"))  return "text/plain; charset=utf-8";
+        if (p.endsWith(".xml"))  return "text/xml; charset=utf-8";
+        if (p.endsWith(".txt") || p.endsWith(".version")) return "text/plain; charset=utf-8";
+        if (p.endsWith(".zip"))  return "application/zip";
+        if (p.endsWith(".bin"))  return "application/octet-stream";
+        return "application/octet-stream";
+    }
+}
diff --git a/rebuild-src/javasrc/com/db/local/server/LocalServerStarter.java b/rebuild-src/javasrc/com/db/local/server/LocalServerStarter.java
new file mode 100644
index 0000000..ec40495
--- /dev/null
+++ b/rebuild-src/javasrc/com/db/local/server/LocalServerStarter.java
@@ -0,0 +1,165 @@
+package com.db.local.server;
+
+import android.content.Context;
+import android.content.res.AssetManager;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+
+/**
+ * Titik masuk mini-server di APK modifikasi — dipanggil dari
+ * Application.onCreate (patch smali com/zhuhuan/game/Application.smali)
+ * SEBELUM jalur boot downloader config jalan (peta 16.5).
+ *
+ * - ekstraksi assets/server_root/**  →  Android/data/com.db.local/server/**
+ *   (root SEBELAH files/, fakta 13.1; files/ milik client — TIDAK disentuh)
+ *   urutan ekstraksi: db/ → file kecil root → js/ → resource/ → upgrade/;
+ *   latch readyEarly dilepas setelah js/ selesai (anti-blokir boot CDN 9528)
+ * - 9527 melayani /bs/db/android/*.bin LANGSUNG dari assets (anti-race boot)
+ * - 5 listener bind 127.0.0.1: 9527/9528/5050/9530/4000 (fallback 4001)
+ * - SEMUA exception ditelan (dilaporkan ke logger) — jangan pernah crash app
+ */
+public final class LocalServerStarter {
+    private static volatile boolean started = false;
+
+    private LocalServerStarter() {}
+
+    public static void start(final Context ctx) {
+        if (started) return;
+        started = true;
+        try {
+            final File extBase = ctx.getExternalFilesDir(null);
+            final File base = extBase != null ? extBase.getParentFile() : null;
+            final File serverRoot = new File(base != null ? base : ctx.getFilesDir(), "server");
+            LoggerCore.serverRootPath = serverRoot.getAbsolutePath();
+
+            final CountDownLatch readyEarly = new CountDownLatch(1);
+            final Thread extractor = new Thread(() -> {
+                try {
+                    long n = extractRec(ctx.getAssets(), "server_root", serverRoot, readyEarly, 0);
+                    LoggerCore.extracted = true;
+                    LoggerCore.extractedFiles = n;
+                    readyEarly.countDown(); // jaga-jaga bila folder js/ tidak ditemukan
+                } catch (Throwable t) {
+                    logBoot("ekstraksi gagal: " + t);
+                    readyEarly.countDown();
+                }
+            }, "server-extract");
+            extractor.setDaemon(true);
+            extractor.start();
+
+            final StaticHandler.AssetsSource assets = rel -> {
+                try {
+                    InputStream in = ctx.getAssets().open(rel);
+                    try {
+                        java.io.ByteArrayOutputStream b = new java.io.ByteArrayOutputStream();
+                        byte[] buf = new byte[8192];
+                        int r;
+                        while ((r = in.read(buf)) > 0) b.write(buf, 0, r);
+                        return b.toByteArray();
+                    } finally {
+                        in.close();
+                    }
+                } catch (IOException ioe) {
+                    return null;
+                }
+            };
+
+            ServerCore.StartResult res = ServerCore.start(serverRoot, assets, readyEarly);
+            logBoot("mini-server aktif; logger di port " + res.loggerPort
+                    + (res.loggerFallback ? " (fallback)" : "") + "; serverRoot=" + serverRoot);
+        } catch (Throwable t) {
+            logBoot("start gagal: " + t);
+        }
+    }
+
+    private static void logBoot(String msg) {
+        LoggerCore.Entry e = new LoggerCore.Entry();
+        e.port = LoggerCore.PORT_LOGGER;
+        e.method = "BOOT";
+        e.path = msg;
+        e.status = 0;
+        LoggerCore.log(e);
+    }
+
+    /** ekstraksi rekursif; latch dilepas setelah folder js/ pada bs/ selesai */
+    static long extractRec(AssetManager am, String assetPath, File targetDir,
+                           CountDownLatch early, long count) throws IOException {
+        String[] list;
+        try {
+            list = am.list(assetPath);
+        } catch (IOException ioe) {
+            return count;
+        }
+        if (list == null || list.length == 0) {
+            copyAsset(am, assetPath, targetDir);
+            return count + 1;
+        }
+        if (!targetDir.exists()) targetDir.mkdirs();
+        List<String> sorted = new ArrayList<>();
+        Collections.addAll(sorted, list);
+        Collections.sort(sorted, (a, b) -> rank(a) - rank(b));
+        for (String name : sorted) {
+            String childAsset = assetPath + "/" + name;
+            File childTarget = new File(targetDir, name);
+            String[] sub;
+            try {
+                sub = am.list(childAsset);
+            } catch (IOException ioe) {
+                sub = null;
+            }
+            if (sub != null && sub.length > 0) {
+                count = extractRec(am, childAsset, childTarget, early, count);
+            } else {
+                copyAsset(am, childAsset, childTarget);
+                count++;
+            }
+        }
+        if ("js".equals(targetDir.getName()) && "bs".equals(targetDir.getParentFile().getName())) {
+            early.countDown();
+        }
+        return count;
+    }
+
+    private static int rank(String name) {
+        if ("db".equals(name)) return 0;
+        if ("index-native.html".equals(name) || "manifest.json".equals(name)
+                || "index.html".equals(name) || "manifest_ts.json".equals(name)
+                || "base.version".equals(name) || "resource.version".equals(name)) return 1;
+        if ("js".equals(name)) return 2;
+        if ("resource".equals(name)) return 3;
+        return 4;
+    }
+
+    private static void copyAsset(AssetManager am, String assetPath, File target) {
+        InputStream in = null;
+        OutputStream out = null;
+        try {
+            File parent = target.getParentFile();
+            if (parent != null && !parent.exists()) parent.mkdirs();
+            in = am.open(assetPath);
+            out = new FileOutputStream(target);
+            byte[] buf = new byte[65536];
+            int r;
+            while ((r = in.read(buf)) > 0) out.write(buf, 0, r);
+        } catch (IOException ioe) {
+            LoggerCore.Entry e = new LoggerCore.Entry();
+            e.port = LoggerCore.PORT_LOGGER;
+            e.method = "EXTRACT";
+            e.path = assetPath;
+            e.status = 500;
+            e.error = String.valueOf(ioe);
+            LoggerCore.log(e);
+        } finally {
+            try { if (in != null) in.close(); } catch (IOException ignored) {}
+            try { if (out != null) out.close(); } catch (IOException ignored) {}
+        }
+    }
+}
diff --git a/rebuild-src/javasrc/com/db/local/server/LoggerCore.java b/rebuild-src/javasrc/com/db/local/server/LoggerCore.java
new file mode 100644
index 0000000..074e921
--- /dev/null
+++ b/rebuild-src/javasrc/com/db/local/server/LoggerCore.java
@@ -0,0 +1,190 @@
+package com.db.local.server;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Logger/monitoring 2 MODE (readme 15.6 / 16.6 — komponen BARU, bukan fakta APK asli):
+ *  - mode ALL  : kronologis lintas port layanan (ring buffer global, cap 2000)
+ *  - mode PORT : ring buffer per port (cap 400/port) — header, preview body req/resp
+ *                (dibatasi 2048 byte), status, durasi, error; khusus 9527 menyertakan
+ *                JSON config TER-DECODE pasca-XOR "DragonBall".
+ * Event bus = in-memory singleton (satu proses — tanpa HTTP hop antar layanan).
+ */
+public final class LoggerCore {
+    public static final int PORT_CONFIG = 9527;
+    public static final int PORT_CDN    = 9528;
+    public static final int PORT_LOGIN  = 5050;
+    public static final int PORT_SDK    = 9530;
+    public static final int PORT_LOGGER = 4000;
+    public static final int PORT_FALLBACK = 4001;
+    public static final int BODY_PREVIEW_MAX = 2048;
+    public static final int GLOBAL_CAP = 2000;
+    public static final int PORT_CAP = 400;
+
+    public static final class Entry {
+        public long seq;
+        public long ts;
+        public int port;
+        public String method;
+        public String path;
+        public int status;
+        public long durMs;
+        public long reqLen;
+        public long respLen;
+        public String reqPreview;
+        public String respPreview;
+        public String extra;     // mis. JSON config ter-decode (9527) / event socket.io
+        public String error;
+
+        String esc(String s) { return s == null ? "" : JsonUtil.esc(s); }
+
+        public String toJson() {
+            StringBuilder b = new StringBuilder(512);
+            b.append("{\"seq\":").append(seq)
+             .append(",\"ts\":").append(ts)
+             .append(",\"time\":\"").append(esc(fmtTime(ts)))
+             .append("\",\"port\":").append(port)
+             .append(",\"method\":\"").append(esc(method))
+             .append("\",\"path\":\"").append(esc(path))
+             .append("\",\"status\":").append(status)
+             .append(",\"durMs\":").append(durMs)
+             .append(",\"reqLen\":").append(reqLen)
+             .append(",\"respLen\":").append(respLen);
+            if (reqPreview != null)  b.append(",\"reqPreview\":\"").append(esc(reqPreview)).append('"');
+            if (respPreview != null) b.append(",\"respPreview\":\"").append(esc(respPreview)).append('"');
+            if (extra != null)       b.append(",\"extra\":\"").append(esc(extra)).append('"');
+            if (error != null)       b.append(",\"error\":\"").append(esc(error)).append('"');
+            b.append('}');
+            return b.toString();
+        }
+
+        static String fmtTime(long ms) {
+            // ISO lokal sederhana tanpa dependensi kalender eksternal
+            java.util.Calendar c = java.util.Calendar.getInstance();
+            c.setTimeInMillis(ms);
+            return String.format("%04d-%02d-%02d %02d:%02d:%02d.%03d",
+                    c.get(java.util.Calendar.YEAR), c.get(java.util.Calendar.MONTH) + 1,
+                    c.get(java.util.Calendar.DAY_OF_MONTH), c.get(java.util.Calendar.HOUR_OF_DAY),
+                    c.get(java.util.Calendar.MINUTE), c.get(java.util.Calendar.SECOND),
+                    c.get(java.util.Calendar.MILLISECOND));
+        }
+
+        public String time() { return fmtTime(ts); }
+    }
+
+    public static final class Counter {
+        public long requests, bytesIn, bytesOut, errors;
+        public String toJson() {
+            return "{\"requests\":" + requests + ",\"bytesIn\":" + bytesIn
+                    + ",\"bytesOut\":" + bytesOut + ",\"errors\":" + errors + "}";
+        }
+    }
+
+    private static final Object LOCK = new Object();
+    private static final ArrayDeque<Entry> GLOBAL = new ArrayDeque<>();
+    @SuppressWarnings("unchecked")
+    private static final ArrayDeque<Entry>[] PER_PORT = new ArrayDeque[6];
+    private static final Map<Integer, Counter> COUNTERS = new LinkedHashMap<>();
+    private static final AtomicLong SEQ = new AtomicLong();
+    public static final long STARTED_AT = System.currentTimeMillis();
+    /** status bind per port (diisi ServerCore) */
+    public static final Map<String, String> BINDS = new LinkedHashMap<>();
+    public static volatile boolean fallbackLogger = false;
+    public static volatile String serverRootPath = "";
+    public static volatile boolean extracted = false;
+    public static volatile long extractedFiles = 0;
+
+    static {
+        for (int i = 0; i < PER_PORT.length; i++) PER_PORT[i] = new ArrayDeque<>();
+        for (int p : new int[]{PORT_CONFIG, PORT_CDN, PORT_LOGIN, PORT_SDK, PORT_LOGGER})
+            COUNTERS.put(p, new Counter());
+    }
+
+    private static int slot(int port) {
+        switch (port) {
+            case PORT_CONFIG: return 0;
+            case PORT_CDN:    return 1;
+            case PORT_LOGIN:  return 2;
+            case PORT_SDK:    return 3;
+            case PORT_LOGGER: return 4;
+            default:          return 5;
+        }
+    }
+
+    public static void log(Entry e) {
+        e.seq = SEQ.incrementAndGet();
+        if (e.ts == 0) e.ts = System.currentTimeMillis();
+        Counter c = COUNTERS.get(e.port);
+        synchronized (LOCK) {
+            if (c != null) {
+                c.requests++;
+                c.bytesIn += e.reqLen;
+                c.bytesOut += e.respLen;
+                if (e.status >= 400 || e.error != null) c.errors++;
+            }
+            GLOBAL.addLast(e);
+            while (GLOBAL.size() > GLOBAL_CAP) GLOBAL.pollFirst();
+            ArrayDeque<Entry> q = PER_PORT[slot(e.port)];
+            q.addLast(e);
+            while (q.size() > PORT_CAP) q.pollFirst();
+        }
+    }
+
+    /** mode ALL — kronologis naik, entri N terakhir */
+    public static ArrayList<Entry> latestGlobal(int limit) {
+        synchronized (LOCK) {
+            ArrayList<Entry> all = new ArrayList<>(GLOBAL);
+            int from = Math.max(0, all.size() - Math.max(1, limit));
+            return new ArrayList<>(all.subList(from, all.size()));
+        }
+    }
+
+    /** mode PORT — kronologis naik, entri N terakhir untuk port tsb */
+    public static ArrayList<Entry> latestPort(int port, int limit) {
+        synchronized (LOCK) {
+            ArrayList<Entry> all = new ArrayList<>(PER_PORT[slot(port)]);
+            int from = Math.max(0, all.size() - Math.max(1, limit));
+            return new ArrayList<>(all.subList(from, all.size()));
+        }
+    }
+
+    public static String statsJson() {
+        StringBuilder b = new StringBuilder(256);
+        b.append("{\"startedAt\":").append(STARTED_AT)
+         .append(",\"uptimeMs\":").append(System.currentTimeMillis() - STARTED_AT)
+         .append(",\"ports\":{");
+        boolean first = true;
+        synchronized (LOCK) {
+            for (Map.Entry<Integer, Counter> en : COUNTERS.entrySet()) {
+                if (!first) b.append(',');
+                first = false;
+                b.append('"').append(en.getKey()).append("\":").append(en.getValue().toJson());
+            }
+        }
+        b.append("}}");
+        return b.toString();
+    }
+
+    public static String healthJson() {
+        StringBuilder b = new StringBuilder(256);
+        b.append("{\"serverRoot\":\"").append(JsonUtil.esc(serverRootPath)).append('"')
+         .append(",\"extracted\":").append(extracted)
+         .append(",\"extractedFiles\":").append(extractedFiles)
+         .append(",\"fallbackLogger\":").append(fallbackLogger)
+         .append(",\"binds\":{");
+        boolean first = true;
+        synchronized (LOCK) {
+            for (Map.Entry<String, String> e : BINDS.entrySet()) {
+                if (!first) b.append(',');
+                first = false;
+                b.append('"').append(e.getKey()).append("\":\"").append(JsonUtil.esc(e.getValue())).append('"');
+            }
+        }
+        b.append("}}");
+        return b.toString();
+    }
+}
diff --git a/rebuild-src/javasrc/com/db/local/server/LoggerHandler.java b/rebuild-src/javasrc/com/db/local/server/LoggerHandler.java
new file mode 100644
index 0000000..0b61a00
--- /dev/null
+++ b/rebuild-src/javasrc/com/db/local/server/LoggerHandler.java
@@ -0,0 +1,143 @@
+package com.db.local.server;
+
+import java.io.IOException;
+import java.io.OutputStream;
+import java.net.Socket;
+import java.util.ArrayList;
+import java.util.Map;
+
+/**
+ * Listener 4000 (fallback 4001 bila bind gagal) — logger/monitoring 2 MODE (16.6):
+ *   GET /                             → dashboard HTML (status listener + cara pakai)
+ *   GET /stats                        → JSON counter per layanan
+ *   GET /health                       → JSON status bind semua port + info ekstraksi
+ *   GET /logs?mode=all&limit=N        → mode ALL: kronologis lintas port layanan
+ *   GET /logs?mode=port&port=P&limit=N → mode PORT: rincian satu port
+ *                                       (9527 menyertakan extra = JSON config ter-decode)
+ * Body preview dibatasi 2 KB (LoggerCore.BODY_PREVIEW_MAX).
+ */
+public final class LoggerHandler implements HttpWorker.Handler {
+    private final int port;
+
+    public LoggerHandler(int port) { this.port = port; }
+
+    @Override
+    public boolean handle(HttpWorker.Request req, OutputStream out, Socket sock) throws IOException {
+        long t0 = System.currentTimeMillis();
+        LoggerCore.Entry e = new LoggerCore.Entry();
+        e.port = port;
+        e.method = req.method;
+        e.path = req.rawPath;
+        e.reqLen = req.body.length;
+
+        String p = req.path;
+        Map<String, String> h;
+        byte[] body;
+        int status;
+
+        if ("/".equals(p) || "".equals(p)) {
+            status = 200;
+            h = HttpWorker.baseHeaders("text/html; charset=utf-8");
+            body = HttpWorker.text(dashboardHtml());
+        } else if ("/stats".equals(p)) {
+            status = 200;
+            h = HttpWorker.baseHeaders("application/json");
+            body = HttpWorker.text(LoggerCore.statsJson());
+        } else if ("/health".equals(p)) {
+            status = 200;
+            h = HttpWorker.baseHeaders("application/json");
+            body = HttpWorker.text(LoggerCore.healthJson());
+        } else if ("/logs".equals(p)) {
+            String mode = req.q("mode") == null ? "all" : req.q("mode");
+            int limit = 200;
+            try {
+                if (req.q("limit") != null) limit = Integer.parseInt(req.q("limit"));
+            } catch (NumberFormatException nfe) { limit = 200; }
+            limit = Math.max(1, Math.min(limit, 2000));
+            int portFilter = 0;
+            try {
+                if (req.q("port") != null) portFilter = Integer.parseInt(req.q("port"));
+            } catch (NumberFormatException nfe) { portFilter = 0; }
+
+            ArrayList<LoggerCore.Entry> list;
+            if ("port".equals(mode)) {
+                if (portFilter != LoggerCore.PORT_CONFIG && portFilter != LoggerCore.PORT_CDN
+                        && portFilter != LoggerCore.PORT_LOGIN && portFilter != LoggerCore.PORT_SDK) {
+                    status = 400;
+                    h = HttpWorker.baseHeaders("application/json");
+                    body = HttpWorker.text("{\"error\":\"port harus 9527|9528|5050|9530\"}");
+                } else {
+                    status = 200;
+                    h = HttpWorker.baseHeaders("application/json");
+                    list = LoggerCore.latestPort(portFilter, limit);
+                    body = HttpWorker.text(entriesJson(mode, portFilter, list));
+                }
+            } else {
+                status = 200;
+                h = HttpWorker.baseHeaders("application/json");
+                list = LoggerCore.latestGlobal(limit);
+                body = HttpWorker.text(entriesJson(mode, 0, list));
+            }
+        } else {
+            status = 404;
+            h = HttpWorker.baseHeaders("application/json");
+            body = HttpWorker.text("{\"error\":\"gunakan / , /stats , /health , /logs?mode=all|port&port=..&limit=N\"}");
+        }
+
+        h.put("Access-Control-Allow-Origin", "*");
+        HttpWorker.writeResponse(out, status, status == 200 || status == 400 ? "OK" : "Not Found",
+                h, body);
+        e.status = status;
+        e.respLen = body.length;
+        if (body.length <= LoggerCore.BODY_PREVIEW_MAX) e.respPreview = new String(body, java.nio.charset.StandardCharsets.UTF_8);
+        else e.respPreview = new String(body, 0, LoggerCore.BODY_PREVIEW_MAX, java.nio.charset.StandardCharsets.UTF_8) + "…";
+        e.durMs = System.currentTimeMillis() - t0;
+        LoggerCore.log(e);
+        return true;
+    }
+
+    private String entriesJson(String mode, int port, ArrayList<LoggerCore.Entry> list) {
+        StringBuilder b = new StringBuilder(64 + list.size() * 256);
+        b.append("{\"mode\":\"").append(mode).append('"');
+        if (port > 0) b.append(",\"port\":").append(port);
+        b.append(",\"count\":").append(list.size())
+         .append(",\"order\":\"kronologis naik (lama → baru)\",\"entries\":[");
+        for (int i = 0; i < list.size(); i++) {
+            if (i > 0) b.append(',');
+            b.append(list.get(i).toJson());
+        }
+        b.append("]}");
+        return b.toString();
+    }
+
+    private String dashboardHtml() {
+        LoggerCore.Entry[] all = LoggerCore.latestGlobal(50)
+                .toArray(new LoggerCore.Entry[0]);
+        StringBuilder rows = new StringBuilder();
+        for (int i = all.length - 1; i >= 0; i--) {
+            LoggerCore.Entry x = all[i];
+            rows.append("<tr><td>").append(x.time()).append("</td><td>").append(x.port)
+                .append("</td><td>").append(x.method).append(" ").append(x.path)

{"id":22,"t":"19:41:28","icon":"📄","text":"GET /bs/index-native.html · mirror www/ · 10,5 KB · 1 ms","detail":"","v":1,"m":"local","isiLabel":"ISI · 10,5 KB (teks)","isi":"<!DOCTYPE HTML>\n<html>\n\n<head>\n    <meta charset=\"utf-8\">\n    <title>DragonBall</title>\n    <meta name=\"viewport\"\n        content=\"width=device-width,initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no\" />\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n    <meta name=\"full-screen\" content=\"true\" />\n    <meta name=\"screen-orientation\" content=\"portrait\" />\n    <meta name=\"x5-fullscreen\" content=\"true\" />\n    <meta name=\"360-fullscreen\" content=\"true\" />\n    <style>\n        html,\n        body {\n            -ms-touch-action: none;\n            background: #888888;\n            padding: 0;\n            border: 0;\n            margin: 0;\n            height: 100%;\n        }\n    </style>\n</head>\n\n<body>\n    <div style=\"margin: auto;width: 100%;height: 100%;\" class=\"egret-player\" data-entry-class=\"Main\"\n        data-orientation=\"portrait\" data-scale-mode=\"showAll\" data-frame-rate=\"60\" data-content-width=\"750\"\n        data-content-height=\"1334\" data-show-paint-rect=\"false\" data-multi-fingered=\"2\" data-show-fps=\"false\"\n        data-show-log=\"false\" data-show-fps-style=\"x:0,y:0,size:12,textColor:0xffffff,bgAlpha:0.9\">\n    </div>\n    <script>\n        window[\"Log_Clean\"] = true;\n        window[\"debug\"] = false;\n        window[\"CacheNum\"] = 20;\n        window[\"reportBattlleLog\"] = \"http://log.sjflaregame.com:10000/error/battle/client\";\n        window[\"privacyUrl\"] = \"http://www.parajoymobile.com/privacy_en.html\";\n        var thirdParams = null; //第三方sdk的参数\n        var loginServer = null; //登录服\n        var clientParams = null; //透传参数\n\n        var getLoginServer = function () {\n            return loginServer;\n        }\n        var loadScript = function (list, callback) {\n            var loaded = 0;\n            var loadNext = function () {\n                loadSingleScript(list[loaded], function () {\n                    loaded++;\n                    if (loaded >= list.length) {\n                        callback();\n                    } else {\n                        loadNext();\n                    }\n                })\n            };\n            loadNext();\n        };\n\n        var loadSingleScript = function (src, callback) {\n            var s = document.createElement('script');\n            s.async = false;\n            s.src = src;\n            s.addEventListener('load', function () {\n                s.parentNode.removeChild(s);\n                s.removeEventListener('load', arguments.callee, false);\n                callback();\n            }, false);\n            document.body.appendChild(s);\n        };\n\n        var xhr = new XMLHttpRequest();\n        xhr.open('GET', './manifest.json?v=' + Math.random(), true);\n        xhr.addEventListener(\"load\", function () {\n            var manifest = JSON.parse(xhr.response);\n            var list = manifest.initial.concat(manifest.game);\n            loadScript(list, function () {\n                /**\n                 * {\n                 * \"renderMode\":, //Engine rendering mode, \"canvas\" or \"webgl\"\n                 * \"audioType\": 0 //Use the audio type, 0: default, 2: web audio, 3: audio\n                 * \"antialias\": //Whether the anti-aliasing is enabled in WebGL mode, true: on, false: off, defaults to false\n                 * \"calculateCanvasScaleFactor\": //a function return canvas scale factor\n                 * }\n                 **/\n\n                window[\"loadJsonFunc\"] = function (path) {\n                    return RES.getRes(path);\n                }\n                window[\"refreshPage\"] = function () {\n                    egret.ExternalInterface.call(\"refresh\", \"refresh\");\n                    window[\"show18Login\"] = clientParams[\"show18Login\"];\n                    window[\"show18Home\"] = clientParams[\"show18Home\"];\n                    window[\"sdkNativeChannel\"] = clientParams[\"sdkNativeChannel\"];\n                    window[\"showCurChannel\"] = clientParams[\"showCurChannel\"];\n                }\n                egret.ExternalInterface.addCallback(\"refresh\", function (msg) {\n                    window.location.reload();\n                });\n                egret.ExternalInterface.addCallback(\"startGame\", function (msg) {\n                    var json = JSON.parse(msg);\n                    if (json.thirdParams && json.thirdParams != \"\") {\n                        thirdParams = JSON.parse(json.thirdParams);\n                        window[\"osType\"] = thirdParams.osType;\n                    }\n                    loginServer = json.loginServer;\n                    window[\"gameIcon\"] = json.thirdChannel;\n                    if (json.clientParams && json.clientParams != \"\") {\n                        clientParams = JSON.parse(json.clientParams);\n                        window[\"hideList\"] = clientParams[\"hideList\"];\n                        window[\"gameIcon\"] = clientParams[\"gameIcon\"];\n                        window[\"supportLang\"] = clientParams[\"supportLang\"];\n                        window[\"battleAudio\"] = clientParams[\"battleAudio\"];\n                        // window[\"showUserCenterSdk\"] = clientParams[\"showUserCenterSdk\"];\n                        // window[\"showContact\"] = clientParams[\"showContact\"];\n                        // window[\"switchAccount\"] = clientParams[\"switchAccount\"];\n                        window[\"sdkNativeChannel\"] = clientParams[\"sdkNativeChannel\"];\n                        window[\"showCurChannel\"] = clientParams[\"showCurChannel\"];\n                    }\n                    if (window[\"osType\"]) {\n                        window[\"version\"] = json.version + \" for \" + window[\"osType\"];\n                    } else {\n                        window[\"version\"] = json.version;\n                    }\n                    window[\"versionConfig\"] = json.versionConfig;\n                    window[\"debugLanguage\"] = json.language;\n                    egret.runEgret({\n                        renderMode: \"webgl\",\n                        audioType: 0,\n                        calculateCanvasScaleFactor: function (context) {\n                            var backingStore = context.backingStorePixelRatio ||\n                                context.webkitBackingStorePixelRatio ||\n                                context.mozBackingStorePixelRatio ||\n                                context.msBackingStorePixelRatio ||\n                                context.oBackingStorePixelRatio ||\n                                context.backingStorePixelRatio || 1;\n                            return (window.devicePixelRatio || 1) / backingStore;\n                        }\n                    });\n                });\n                egret.ExternalInterface.call(\"startGame\", \"get Sdk Channel\");\n\n            });\n        });\n        xhr.send(null);\n    </script>\n    <script>\n        var checkSDK = function () {\n            egret.ExternalInterface.call(\"changeView\", \"change view\");\n            return true;\n        }\n        var getSdkLoginInfo = function () {\n            var sdkData = thirdParams.data;\n            if (sdkData && sdkData.securityCode) { \n                // 这是配合海贼、乱斗的登录服务器\n                return {sdk:sdkData.sdk,nickName:sdkData.nickname,userId:sdkData.userid,security:sdkData.securityCode};\n            }\n            return thirdParams;\n        }\n\n        var checkFromNative = function () {\n            // 增加这个方法，支付的时候全部都只能一个一个买（不能设置数量）\n            return true;\n        }\n        var paySdk = function (data) {\n            data.power = data.money;\n            if (data.h5payParam) {\n                // 越南渠道特有的处理\n                data.serverName = data.serverId;\n            }\n            egret.ExternalInterface.call(\"pei\", JSON.stringify(data));\n        }\n        var switchUser = function () {\n            egret.ExternalInterface.call(\"refresh\", \"switch usr\");\n        };\n        //facebook 分享 serverId    roleName  extra  需要把这三个字段传一下  extra 可以为空\n        var giveLikeSdk = function (data) {\n            egret.ExternalInterface.call(\"giveLike\", JSON.stringify(data));\n        };\n        //客服中心\n        var contactSdk = function () {\n            egret.ExternalInterface.call(\"contact\", \"contact\");\n        };\n\n        //切换账户 贪玩en\n        var switchAccountSdk = function () {\n            egret.ExternalInterface.call(\"switchAccount\", \"switchAccount\");\n        };\n\n        //fb 点赞\n        var fbGiveLiveSdk = function () {\n            egret.ExternalInterface.call(\"fbGiveLive\", \"fbGiveLive\");\n        };\n\n        //用户中心\n        var userCenterSdk = function () {\n            egret.ExternalInterface.call(\"userCenter\", \"userCenter\");\n        };\n        //领取礼包\n        var gifBagSdk = function () {\n            egret.ExternalInterface.call(\"gifBag\", \"gifBag\");\n        };\n\n        var report2Sdk = function (data) {\n            data.powerNum = data.moneyNum;\n            egret.ExternalInterface.call(\"report2Third\", JSON.stringify(data));\n        };\n        var gameChapterFinish = function (lessonId) {\n            if (thirdParams && thirdParams.sdkType == \"PP\") {\n                var data = {\n                    dataType: 12,\n                    level: lessonId\n                };\n                egret.ExternalInterface.call(\"report2Third\", JSON.stringify(data));\n            }\n        }\n        var openShopPage = function () {\n            if (thirdParams && thirdParams.sdkType == \"PP\") {\n                var data = {\n                    dataType: 13\n                };\n                egret.ExternalInterface.call(\"report2Third\", JSON.stringify(data));\n            }\n        }\n        var gameLevelUp = function (level) {\n            if (thirdParams && thirdParams.sdkType == \"PP\") {\n                var data = {\n                    dataType: 11,\n                    level: level\n                };\n                egret.ExternalInterface.call(\"report2Third\", JSON.stringify(data));\n            }\n        }\n        var tutorialFinish = function () {\n            if (thirdParams && thirdParams.sdkType == \"PP\") {\n                var data = {\n                    dataType: 14\n                };\n                egret.ExternalInterface.call(\"report2Third\", JSON.stringify(data));\n            }\n        }\n        var reload = function () {\n            egret.ExternalInterface.call(\"refresh\", \"reload game\");\n        };\n\n        var changeLanguage = function (lang) {\n            egret.ExternalInterface.call(\"changeLanguage\", lang);\n            window.location.reload();\n        }\n        var openURL = function (url) {\n            egret.ExternalInterface.call(\"openURL\", url);\n        }\n\n        var open = function (url, target) {\n            egret.ExternalInterface.call(\"openURL\", url);\n        }\n    </script>\n</body>\n\n</html>"}

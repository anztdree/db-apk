+         .append(" if(j.disk&&j.disk.enabled)t+='  | arsip '+j.disk.file+' '+(j.disk.bytes>=1024?Math.round(j.disk.bytes/1024)+'KB':j.disk.bytes+'B')+' '+j.disk.lines+' baris';\n")

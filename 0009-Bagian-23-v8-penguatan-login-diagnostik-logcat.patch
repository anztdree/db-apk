# PATCH 0009 — Bagian 23: v8 = penguatan jalur login (0009A) + diagnostik logcat otomatis (0009B)
# Basis: APK v7 (sha256 a733c8bea634893024d7210d9f5cc78a1443cd7644133adae0145b9b1902d73a)
#        -> v8  (sha256 3d2f9008cebe383877a5abf58933506749a05d199cd4537658c97565d959f993)
# Latar: v7 sudah berjalan di device (log REGISTER-VISITOR 22) dan popup tetap muncul +
#        TIDAK ADA request ke semua port lokal setelah registerVisitor (bukti: log device
#        23 event). Diagnosis lengkap: readme.md Bagian 23.1-23.3.
#
# RINGKASAN AKAR (baca Bagian 23):
#   Event LOGIN_RAND selalu di-post callback registerVisitor — KECUALI exception dilempar
#   DI DALAM QuickGameSdkService.seventygenom(0xe) (dipanggil SEBELUM flag sukses diset ->
#   catch callback mengirim event sebagai GAGAL -> HWLoginActivity menampilkan fragment
#   error / dialog tetap menggantung). Satu-satunya blok TANPA try-catch di jalur itu =
#   Facebook AppEventsLogger (pursetruechild()==true karena manifest memuat
#   com.facebook.sdk.ApplicationId + FacebookInitProvider). Karena rantai game pasca-login
#   (loginchecknative ke 127.0.0.1:5050, retry 5s/10s, popup check_network) TIDAK MENINGGALKAN
#   JEJAK di logger (tidak ada request 5050 di log) -> thread game tidak pernah jalan ->
#   kegagalan ada di SDK sebelum enterGame; titik persisnya hanya bisa dibuktikan lewat
#   logcat device. Server embedded berjalan di proses yang SAMA dengan aplikasi ->
#   `logcat -d` dari proses itu dapat membaca log SDK sendiri.

--- a/smali/com/quickgame/android/sdk/service/QuickGameSdkService.smali
+++ b/smali/com/quickgame/android/sdk/service/QuickGameSdkService.smali
@@ (seventygenom(I), awal method — blok Facebook diapit try-catch baru)

-    invoke-static {}, Lcom/quickgame/android/sdk/unnecessarysperrylites/seventygenom;->pursetruechild()Z
+    :try_start_d1
+    invoke-static {}, Lcom/quickgame/android/sdk/unnecessarysperrylites/seventygenom;->pursetruechild()Z

     move-result v2

     if-eqz v2, :cond_0

-    .line 2
     invoke-virtual {v0}, Lcom/quickgame/android/sdk/feedtonight;->rawturn()Landroid/content/Context;

     move-result-object v2

     invoke-static {v2}, Lcom/facebook/appevents/AppEventsLogger;->newLogger(Landroid/content/Context;)Lcom/facebook/appevents/AppEventsLogger;

     move-result-object v2

     const-string v3, "fb_custom_login_user_name"

-    .line 3
     invoke-virtual {v2, v3}, Lcom/facebook/appevents/AppEventsLogger;->logEvent(Ljava/lang/String;)V

+    :try_end_d1
+    .catch Ljava/lang/Exception; {:try_start_d1 .. :try_end_d1} :catch_d1
+
+    goto/16 :goto_d1
+
+    :catch_d1
+    move-exception v2
+
+    const-string v3, "DBLocalDiag"
+
+    const-string v10, "0009A: FB logEvent throw -> diabaikan, login lanjut"
+
+    invoke-static {v3, v10}, Landroid/util/Log;->w(Ljava/lang/String;Ljava/lang/String;)I
+
+    invoke-virtual {v2}, Ljava/lang/Exception;->printStackTrace()V
+
+    :goto_d1
     .line 4
     :cond_0

 (Semua register v0/v1 tidak disentuh handler; v2/v3/v10 adalah register scratch yang
  di-reload sebelum dipakai di :cond_0 — aman. Label try_lain di method ini (try_start_0
  milik blok tracking) tidak bertabrakan karena pakai akhiran _d1.)

+++ b/smali_classes2/com/db/local/server/LogcatDumper.smali   (FILE BARU)
+(kelas baru, implements Runnable)
+  - static kick(): sekali per proses (flag `started` + monitor pada class) ->
+    spawn Thread "DBLocal-LogcatDump".
+  - run(): Thread.sleep(8000) -> Runtime.exec("logcat -d -v time -s HWLoginActivity:V
+    GameSDKImpl:V GameSdkService:V QGAuthToken:V QGConnectManager:V Overseas:V
+    WaitingDialog:V QGSp:V switchfragment:V TAG:V ReadUtil:V System.err:V
+    AndroidRuntime:V QuickGameSdkService:V QuickSdkApplication:V AppsFlyerManager:V
+    AdjustManager:V AppEventsLogManager:V MainActivity:V LaunchActivity:V DBLocalDiag:V *:S")
+    -> baca baris, akumulasi chunk <=750 char (maks 30 chunk) ->
+    LoggerCore$Entry{port=4000 (0xfa0), kind="LOGCAT", method="LOGCAT",
+    path="logcat-dump 0009B (auto 8s setelah registerVisitor/init)", status=0,
+    extra=<isi chunk>} -> LoggerCore.log() -> masuk arsip NDJSON (server/logs).
+  - Throwable ditangkap -> printStackTrace (tidak pernah mengganggu server).

--- a/smali_classes2/com/db/local/server/SdkHandler.smali
+++ b/smali_classes2/com/db/local/server/SdkHandler.smali
@@ (cabang /v1/system/init, setelah konstanta INIT_OK)
+    invoke-static {}, Lcom/db/local/server/LogcatDumper;->kick()V

@@ (cabang /v1/user/registerVisitor, setelah respons dibangun)
+    invoke-static {}, Lcom/db/local/server/LogcatDumper;->kick()V

 (teks log REGISTER-VISITOR 22 -> REGISTER-VISITOR 23 dengan ringkasan v8; catatan:
  kick() dipasang di DUA cabang agar dump tetap jalan walau registerVisitor tidak pernah
  terjadi — flag `started` menjamin dump hanya 1x per proses)

 (patch 0008 TIDAK diubah: SdkHandler registerVisitor tetap const/4 v2, 0x0 ->
  sdkDataResponse(false) = isNewUser=0; f/a/n tetap setCancelable(0x1))
